# Copy this file to ".env.local" (for local dev) or set these in your host's
# dashboard (e.g. Vercel → Project → Settings → Environment Variables).
# None are required to see the site — the form falls back to opening the
# visitor's email app until you set these up.

# --- Enquiry form email (recommended) ---
# 1. Create a free account at https://resend.com
# 2. Make an API key and paste it here.
RESEND_API_KEY=

# Where enquiries are delivered (your mum's inbox).
ENQUIRY_TO_EMAIL=

# The "from" address. Until you verify your own domain in Resend, you can use
# the default below. To send from your own domain, verify it in Resend first.
# ENQUIRY_FROM_EMAIL=Ecoweave <hello@yourdomain.com>

# --- Public details shown on the site ---
# The contact email shown on the page / used for the email fallback.
NEXT_PUBLIC_SHOP_EMAIL=hello@ecoweave.shop

# Optional extra contact links under the form. Leave blank to hide.
NEXT_PUBLIC_FACEBOOK_URL=
# WhatsApp number, digits only with country code, e.g. 27821234567
NEXT_PUBLIC_WHATSAPP=
